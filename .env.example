# Levaintron demo — copy to .env and adjust if needed. All values optional.

# Mock ordering hub (defaults to the local mock hub; no auth token needed)
#HUB_BASE_URL=http://127.0.0.1:8099/index.html

# Demo database (note the name: DEMO_DATABASE_URL, so the demo can never
# accidentally pick up a production DATABASE_URL from your shell)
#DEMO_DATABASE_URL=postgresql://postgres:8989@127.0.0.1:5432/levaintron_demo

# Optional email summaries (off unless all three are set)
#SMTP_USER=
#SMTP_PASS=
#NOTIFICATION_EMAIL=
