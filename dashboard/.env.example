# Levaintron demo dashboard — copy to .env. Values here OVERRIDE your shell
# (see server/load-env.ts) so a production DATABASE_URL can never leak in.

# Demo database only. server/db.ts refuses any other database name.
DATABASE_URL=postgresql://postgres:8989@127.0.0.1:5432/levaintron_demo

# Port 5000 is the production dashboard on a dev box; the demo uses 5001.
PORT=5001

# Where "Run pipeline" spawns from. Defaults to the parent of the dashboard
# directory (the demo repo root), so this is normally left unset.
#PIPELINE_PATH=/absolute/path/to/Levaintron_V1
# Defaults to <PIPELINE_PATH>/levaintron/bin/python when that venv exists.
#PYTHON_PATH=/absolute/path/to/Levaintron_V1/levaintron/bin/python
